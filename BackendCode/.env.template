# BackendCode/.env
# Copy this file to BackendCode/.env and fill in real values.
# Do NOT commit BackendCode/.env to GitHub.

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase API keys
# - ANON key is used to call Supabase Auth endpoints.
# - SERVICE ROLE key is server-side only (bypasses RLS) and must NEVER be exposed to the frontend.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret (optional in this repo; only needed if you validate JWTs locally instead of via /auth/v1/user)
# SUPABASE_JWT_SECRET=

# Storage bucket where raw IMU uploads land (must match your Supabase Storage bucket name)
SUPABASE_STORAGE_BUCKET=

# Optional: base URL your frontend uses to reach this backend
API_BASE_URL=http://127.0.0.1:8000
