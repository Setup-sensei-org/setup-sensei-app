-- Add a username column separate from auth password handling
ALTER TABLE public.profiles
ADD COLUMN IF NOT EXISTS username text;

-- Add unique constraint to username (prevents duplicates)
ALTER TABLE public.profiles
ADD CONSTRAINT profiles_username_unique UNIQUE (username);

-- Add format check for username (2-30 chars, letters/numbers/_/- only)
ALTER TABLE public.profiles
ADD CONSTRAINT profiles_username_format
CHECK (username ~ '^[a-zA-Z0-9_.-]{2,30}$');

-- Backfill username for existing rows using name or email prefix
UPDATE public.profiles
SET username = COALESCE(name, split_part(email, '@', 1))
WHERE username IS NULL;

-- Add index for fast username lookups during login
CREATE INDEX IF NOT EXISTS profiles_username_idx ON public.profiles(username);

