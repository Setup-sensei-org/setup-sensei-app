-- Migration 14: Create roadmap_nodes table for training progression
CREATE TABLE IF NOT EXISTS public.roadmap_nodes (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  
  -- Level/progression tracking
  level integer not null,
  title text not null,
  subtitle text,
  status text not null default 'locked' check (status in ('locked', 'active', 'completed')),
  type text not null check (type in ('FUNDAMENTALS', 'STRIKING', 'POWER', 'DEFENSE', 'ADVANCED', 'MASTERY', 'TECHNIQUE', 'COMBO')),
  description text,
  path_direction text check (path_direction in ('left', 'right', 'straight')),
  
  created_at timestamptz not null default now(),
  updated_at timestamptz default now()
);

-- Indexes for common queries
create index if not exists roadmap_nodes_user_id_idx
  on public.roadmap_nodes(user_id);

create index if not exists roadmap_nodes_user_level_idx
  on public.roadmap_nodes(user_id, level);

-- Enable RLS
alter table public.roadmap_nodes enable row level security;

-- Users can only see and manage their own roadmap nodes
create policy "roadmap_nodes_select_own"
on public.roadmap_nodes
for select
to authenticated
using (auth.uid() = user_id);

create policy "roadmap_nodes_insert_own"
on public.roadmap_nodes
for insert
to authenticated
with check (auth.uid() = user_id);

create policy "roadmap_nodes_update_own"
on public.roadmap_nodes
for update
to authenticated
using (auth.uid() = user_id)
with check (auth.uid() = user_id);

create policy "roadmap_nodes_delete_own"
on public.roadmap_nodes
for delete
to authenticated
using (auth.uid() = user_id);
